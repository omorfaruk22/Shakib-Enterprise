# SAKIB ENTERPRISE — Environment Example
# Copy to .env on server and fill real values. NEVER commit .env to git.

APP_NAME="SAKIB ENTERPRISE"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sakibenterprise.com.bd

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sakib_enterprise
DB_USERNAME=sakib_user
DB_PASSWORD=change_this_password

# Session
SESSION_LIFETIME=1800
SESSION_SECURE=false
