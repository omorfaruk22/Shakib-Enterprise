Options -Indexes

# If the project root is accidentally used as the document root, deny private areas.
<IfModule mod_authz_core.c>
  <FilesMatch "^(\.env|\.env\..*|.*\.sql|composer\.(json|lock))$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^public/ - [F,L]
  RewriteRule ^(app|config|database|resources|routes|scripts|storage|work)(/|$) - [F,L,NC]
</IfModule>
