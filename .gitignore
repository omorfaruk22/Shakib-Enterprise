# Environment & secrets
.env
.env.local
.env.production

# Logs & cache
storage/logs/*.log
storage/cache/*
!storage/logs/.gitkeep
!storage/cache/.gitkeep

# Uploads (user-generated content)
public/assets/uploads/*
!public/assets/uploads/.htaccess
!public/assets/uploads/.gitkeep

# OS/IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Composer/node if ever added
vendor/
node_modules/
npm-debug.log

# Install lock (one-time)
storage/installed.lock
